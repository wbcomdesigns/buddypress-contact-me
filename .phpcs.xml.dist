<?xml version="1.0"?>
<ruleset name="buddypress-contact-me">
	<description>WordPress Coding Standards for BuddyPress Contact Me.</description>
	<file>.</file>
	<exclude-pattern>/edd-license/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<exclude-pattern>/bin/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<config name="testVersion" value="8.1-"/>
	<config name="minimum_supported_wp_version" value="6.5"/>
	<rule ref="WordPress"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="buddypress-contact-me"/>
		</properties>
	</rule>
</ruleset>
