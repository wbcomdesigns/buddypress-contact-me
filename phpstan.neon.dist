# Run: phpstan analyse -c phpstan.neon.dist (needs szepeviktor/phpstan-wordpress
# and a BuddyPress checkout next to this plugin, as on a normal WP install).
includes:
    - %env.HOME%/.composer/vendor/szepeviktor/phpstan-wordpress/extension.neon
parameters:
    level: 5
    paths:
        - buddypress-contact-me.php
        - uninstall.php
        - includes
        - public
    scanDirectories:
        - ../buddypress
        - libs
    bootstrapFiles:
        - bin/phpstan-bootstrap.php
    dynamicConstantNames:
        - COOKIEPATH
    excludePaths:
        - edd-license
    ignoreErrors:
        # Older bundled SDK copies can win version arbitration and lack set_fallback() (signed-updates guideline step 3).
        - '#Call to function method_exists\(\) with .+set_fallback.+ will always evaluate#'
